{
  "fps": 24,
  "aesthetic_constraints": {
    "composition": {
      "allowed_base_shapes": ["C", "S", "L", "T", "X", "Z", "Triangle"],
      "require_asymmetry": true,
      "enforce_breathing_room": true,
      "one_idea_per_shot": true
    },
    "lighting": {
      "primary_technique": "Three-point lighting",
      "require_counterchange": true,
      "background_value_range": "20-40%",
      "foreground_value_range": "95-100%"
    },
    "lenses": {
      "action_fov_mm": [24, 35],
      "standard_fov_mm": [40, 50],
      "beauty_isolate_fov_mm": [85, 135]
    },
    "editing": {
      "cut_on_action": true,
      "cause_before_effect": true,
      "enforce_180_rule": true
    },
    "camera": {
      "prefer_static_unless_motivated": true,
      "dutch_angle_only_for_extreme_tension": true
    }
  },
  "williams_keywords": [
    "extremes",
    "breakdowns",
    "inbetweens",
    "contact",
    "passing",
    "cushioning",
    "arcs",
    "anticipation",
    "follow-through",
    "moving hold"
  ]
}
