{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SceneIR",
  "type": "object",
  "properties": {
    "scene_id": { "type": "string" },
    "narrative_question": { "type": "string" },
    "theme": { "type": "string" },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot_id": { "type": "string" },
          "focal_point": { "type": "string" },
          "verb": { "type": "string" },
          "composition_shape": {
            "type": "string",
            "enum": ["C", "S", "L", "T", "X", "Z", "Triangle"]
          },
          "lens_mm": { "type": "integer", "default": 50 },
          "duration_frames": { "type": "integer", "minimum": 12 },
          "180_line_side": {
            "type": "string",
            "enum": ["left", "right", "neutral"]
          },
          "action_phases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string",
                  "enum": ["anticipation", "action", "aftermath"]
                },
                "frame_start": { "type": "integer" },
                "frame_end": { "type": "integer" }
              },
              "required": ["phase", "frame_start", "frame_end"]
            }
          }
        },
        "required": [
          "shot_id",
          "focal_point",
          "duration_frames",
          "action_phases"
        ]
      }
    }
  },
  "required": ["scene_id", "shots"]
}
