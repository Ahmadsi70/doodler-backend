{
  "schema": "transition_grammar#v1",
  "default_frames": 12,
  "transitions": {
    "hard_cut": { "frames": 2, "opacity": true, "slide": false },
    "crossfade": { "frames": 12, "opacity": true, "slide": true },
    "dissolve": { "frames": 18, "opacity": true, "slide": false },
    "match_cut": { "frames": 4, "opacity": true, "slide": false },
    "hold_black": { "frames": 8, "opacity": true, "slide": false }
  },
  "beat_pair_rules": [
    { "from_beat": "quiet_hold", "to_beat": "*", "transition": "dissolve" },
    { "from_beat": "*", "to_beat": "reaction", "transition": "hard_cut" },
    { "from_beat": "reaction", "to_beat": "*", "transition": "hard_cut" },
    { "from_beat": "*", "to_beat": "*", "transition": "crossfade" }
  ]
}
